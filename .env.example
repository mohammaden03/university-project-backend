# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Manuscript AI Backend Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://app_user:replace_me@localhost:5432/manuscript_ai"

# CORS & Frontend Origins
FRONTEND_ORIGIN="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# JWT Authentication
JWT_ACCESS_SECRET="replace_with_a_secure_random_secret_at_least_32_chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace_with_a_secure_refresh_token_secret_32_chars"
JWT_REFRESH_TTL="7d"

# Storage & File Constraints
UPLOAD_DIR="./storage/uploads"
MODEL_DIR="./storage/models"
MAX_UPLOAD_SIZE_MB=20
MAX_IMAGE_PIXELS=40000000

# Seeding Configuration
# Set AUTO_SEED=true to automatically populate sample manuscripts and default accounts on empty DB
AUTO_SEED=false
ADMIN_INITIAL_PASSWORD="AdminPass2026!"
RESEARCHER_INITIAL_PASSWORD="ResearchPass2026!"
VIEWER_INITIAL_PASSWORD="ViewerPass2026!"

# Python AI Service Integration
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TIMEOUT_MS=120000
# AI_PROVIDER: 'mock' for local development; 'pretrained' or 'finetuned' for real GPU inference
AI_PROVIDER="mock"
# In production, mock mode is strictly rejected unless ENABLE_MOCK_AI=true is explicitly set
ENABLE_MOCK_AI=false
MODEL_ID="trocr-base-persian-nastaliq"
MODEL_VERSION="v1.2.0"

# Logging & Telemetry
LOG_LEVEL="info"


